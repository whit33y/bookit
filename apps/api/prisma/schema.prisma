generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  OWNER
  EMPLOYEE
  ADMIN
}

// Stan zgłoszenia firmy (#141). Osobna oś od `isBlocked`: status mówi „czy w ogóle wpuszczona",
// `isBlocked` — „wpuszczona, ale ukarana". Firma działa dopiero jako APPROVED i niezablokowana.
enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_BUSINESS
  COMPLETED
}

enum DepositType {
  FIXED // depositValue w groszach
  PERCENT // depositValue w procentach ceny (1–100)
}

enum PaymentStatus {
  PENDING // PaymentIntent utworzony, czekamy na potwierdzenie webhookiem (#51)
  SUCCEEDED
  FAILED
  CANCELLED // rezerwacja wygasła nieopłacona (#51)
  REFUNDED // zaliczka zwrócona: odwołanie w terminie albo przez firmę (#52)
  FORFEITED // zaliczka przepadła: klient odwołał po terminie z polityki firmy (#52)
}

// Rodzaj powiadomienia in-app (#54). Osobny enum, nie BookingStatus: dwa zdarzenia kanału
// (nowa rezerwacja, przypomnienie) nie są przejściami w maszynie stanów, a statusy bez
// adresata (PENDING, COMPLETED) nie mają tu odpowiednika.
enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_DECLINED
  BOOKING_CANCELLED_BY_CLIENT
  BOOKING_CANCELLED_BY_BUSINESS
  BOOKING_REMINDER
  // decyzje administratora o zgłoszeniu firmy (#143) — pierwsze powiadomienia bez wizyty,
  // korzystają z nullowalnego `Notification.bookingId`
  BUSINESS_APPROVED
  BUSINESS_REJECTED
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  role               UserRole @default(CLIENT)
  isBlocked          Boolean  @default(false)
  // Konto założone „za kogoś" (#144: administrator zakłada konto kolejnemu administratorowi)
  // dostaje hasło od kogoś innego, więc do zmiany hasła nie wolno go dopuścić dalej niż do
  // własnego profilu. Flaga jest ogólna, nie sprawdzeniem roli — ten sam strażnik obsłuży
  // każde kolejne źródło takich kont.
  mustChangePassword Boolean  @default(false)
  // Zdjęcie profilowe (#163): hash treści albo `null` = „osoba nie ma zdjęcia" (monogram).
  // Bajty leżą w `UserImage`, nigdy tutaj — `User` jest czytany na każdej trasie z tokenem.
  avatarVersion      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business      Business?
  employee      Employee?
  bookings      Booking[]
  reviews       Review[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  image         UserImage?
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id         String     @id @default(uuid())
  name       String     @unique
  slug       String     @unique
  businesses Business[]
}

model Business {
  id                String         @id @default(uuid())
  ownerId           String         @unique
  categoryId        String
  name              String
  slug              String         @unique
  description       String?
  phone             String?
  street            String
  city              String
  postalCode        String?
  lat               Float
  lng               Float
  // polityka odwołań: klient może odwołać/przenieść do X godzin przed wizytą
  cancellationHours Int            @default(24)
  status            BusinessStatus @default(PENDING)
  // powód odrzucenia zgłoszenia przez administratora (#143); czyszczony przy ponownym zgłoszeniu
  rejectionReason   String?
  isBlocked         Boolean        @default(false)
  // Wizerunek firmy (#153): krótki hash treści obrazu, `null` = brak. Odpowiada naraz na
  // „czy obraz jest" i służy za cache-buster w URL-u; bajty leżą w `BusinessImage`, nigdy tutaj.
  logoVersion       String?
  coverVersion      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id])
  category  Category   @relation(fields: [categoryId], references: [id])
  employees Employee[]
  services  Service[]
  bookings  Booking[]
  reviews   Review[]
  images    BusinessImage[]

  @@index([city])
  @@index([categoryId])
  // kolejka zgłoszeń administratora (#143) filtruje wyłącznie po statusie
  @@index([status])
}

enum BusinessImageKind {
  LOGO
  COVER
}

/// Zdjęcie profilowe (#163). Jeden slot na osobę, więc — inaczej niż `BusinessImage` — bez
/// kolumny `kind`: rolę klucza pełni sam `userId`. Bajty w Postgresie, uzasadnienie w ADR-0001.
model UserImage {
  id        String   @id @default(uuid())
  // @unique zamiast @@unique([userId, kind]): jedno zdjęcie na konto, PUT je nadpisuje
  userId    String   @unique
  // zawsze image/webp — trzymane jawnie, żeby publiczny GET nie zgadywał nagłówka
  mime      String
  // hash treści tych właśnie bajtów; ta sama wartość ląduje w `User.avatarVersion`, ale ETag
  // liczy się stąd — powód ten sam, co przy obrazach firm
  version   String
  bytes     Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Bajty logo firmy i okładki profilu (#153). Osobna tabela, bo blob w `Business` zaciągałby
/// się przy każdym `findMany` bez `select` — uzasadnienie w ADR-0001. Jeden wiersz na slot:
/// `@@unique([businessId, kind])` sprawia, że wgranie nowego obrazu nadpisuje, a nie duplikuje.
model BusinessImage {
  id         String            @id @default(uuid())
  businessId String
  kind       BusinessImageKind
  // zawsze image/webp — trzymane jawnie, żeby publiczny GET nie zgadywał nagłówka
  mime       String
  // hash treści tych właśnie bajtów. Ta sama wartość ląduje w `Business.logoVersion`, ale ETag
  // liczy się stąd: gdyby brać go z `Business` osobnym zapytaniem, równoległy PUT między
  // odczytami wystawiłby stare bajty pod nowym ETagiem — i klient zapisałby tę pomyłkę
  // w cache na rok (`immutable`).
  version    String
  bytes      Bytes
  updatedAt  DateTime          @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, kind])
}

model Employee {
  id         String  @id @default(uuid())
  businessId String
  userId     String? @unique // pracownik może (nie musi) mieć konto w systemie
  name       String
  isActive   Boolean @default(true)

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id])
  services     Service[]
  workingHours WorkingHours[]
  timeOffs     TimeOff[]
  bookings     Booking[]
}

model Service {
  id          String  @id @default(uuid())
  businessId  String
  name        String
  description String?
  durationMin Int
  priceCents  Int // pełna cena usługi w groszach; na miejscu klient dopłaca ją pomniejszoną o zaliczkę
  isActive    Boolean @default(true)

  // null = usługa bez zaliczki, cała płatność na miejscu. Oba pola ustawiane razem —
  // pilnują tego CHECK-i w migracji, bo sam typ bez kwoty nie daje się przeliczyć na
  // PaymentIntent, a #51 wywaliłoby się dopiero wtedy, gdy klient jest już w kasie.
  depositType  DepositType?
  depositValue Int?

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employees Employee[]
  bookings  Booking[]
}

model WorkingHours {
  id         String @id @default(uuid())
  employeeId String
  weekday    Int // 0 = poniedziałek … 6 = niedziela
  startTime  String // "09:00" — czas lokalny firmy
  endTime    String // "17:00"

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, weekday])
}

model TimeOff {
  id         String   @id @default(uuid())
  employeeId String
  startsAt   DateTime
  endsAt     DateTime
  reason     String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Booking {
  id             String        @id @default(uuid())
  clientId       String
  businessId     String
  employeeId     String
  serviceId      String
  startsAt       DateTime
  endsAt         DateTime
  status         BookingStatus @default(PENDING)
  clientNote     String?
  reminderSentAt DateTime? // ustawiane przez cron po wysłaniu przypomnienia
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client   User     @relation(fields: [clientId], references: [id])
  business Business @relation(fields: [businessId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])
  review        Review?
  payment       Payment?
  notifications Notification[]

  @@index([employeeId, startsAt])
  @@index([clientId])
  @@index([businessId, startsAt])
  // oba crony filtrują po status + dacie, bez zawężenia do firmy ani pracownika,
  // więc indeksy powyżej im nie pomagają — bez tych dwóch skan całej tabeli 96 razy na dobę
  @@index([status, startsAt]) // cron przypomnień (#38)
  @@index([status, endsAt]) // cron auto-COMPLETED (#39)
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique // 1:1 z rezerwacją — dokładnie jedna recenzja na wizytę
  clientId   String
  businessId String
  rating     Int // 1–5; poza Prismą pilnuje tego CHECK w migracji i DTO (#47)
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Cascade, bo seed kasuje i odtwarza rezerwacje firm demo przy każdym przebiegu —
  // przy RESTRICT drugie `prisma db seed` wywaliłoby się na kluczu obcym.
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client   User     @relation(fields: [clientId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  // clientId i businessId są zdenormalizowane (da się je wyprowadzić z Booking): średnia oceny
  // i lista recenzji firmy idą wtedy po jednej tabeli, bez joina przy każdym wyniku wyszukiwarki.
  @@index([businessId, createdAt]) // publiczna lista recenzji firmy z paginacją (#47)
  @@index([clientId])
}

model Payment {
  id                    String        @id @default(uuid())
  bookingId             String        @unique // 1:1 z rezerwacją — dokładnie jedna zaliczka na wizytę
  amountCents           Int // kwota zaliczki wyliczona przy rezerwacji, w groszach
  currency              String        @default("pln")
  status                PaymentStatus @default(PENDING)
  // nullable, bo wiersz powstaje w tej samej transakcji co rezerwacja, a identyfikatory
  // ze Stripe dopinamy po odpowiedzi z API; @unique daje webhookowi idempotentny lookup (#51)
  stripePaymentIntentId String?       @unique
  stripeChargeId        String? // potrzebne do refundu (#52)
  paidAt                DateTime?

  // Prowizja platformy od zaliczki (#52). Naliczana raz, przy tworzeniu wiersza, i przypięta
  // do niego na stałe — zmiana stawki w PLATFORM_FEE_PERCENT nie może ruszyć rozliczeń
  // płatności, które już się odbyły. Zapis do rozliczeń, nie `application_fee_amount` ze
  // Stripe'a: to wymaga Connect i konta firmy po tamtej stronie, czego model Business nie ma.
  platformFeeCents Int @default(0)
  // Zwrot: kwota i moment. Osobne pola zamiast samego statusu REFUNDED, bo klient ma zobaczyć
  // ile i kiedy mu wróciło (#53), a `amountCents` musi zostać nietknięte jako kwota pobrana.
  refundedAmountCents Int?
  refundedAt          DateTime?
  // @unique jak przy stripePaymentIntentId — daje webhookowi `charge.refunded` idempotentny
  // lookup i zostawia ślad do zestawienia z dashboardem Stripe'a.
  stripeRefundId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade jak w Review: seed kasuje i odtwarza rezerwacje firm demo przy każdym przebiegu —
  // przy RESTRICT drugie `prisma db seed` wywaliłoby się na kluczu obcym.
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, createdAt]) // cron wygaszania nieopłaconych rezerwacji (#51)
}

// Powiadomienie in-app (#54) — drugi kanał obok maila, zapisywany przy tych samych zdarzeniach
// rezerwacji i dla tego samego adresata (BOOKING_EVENT_RECIPIENT w notifications/templates).
model Notification {
  id     String           @id @default(uuid())
  userId String
  type   NotificationType
  // Treść zdenormalizowana, a nie renderowana przy odczycie: powiadomienie jest zamrożoną
  // wiadomością (tak jak wysłany mail) — późniejsza zmiana terminu czy statusu wizyty nie może
  // przepisać historii, a lista dla dzwoneczka schodzi wtedy do jednego SELECT-a bez joinów,
  // co przy pollingu co minutę ma znaczenie.
  title String
  body  String
  // Ścieżka w apps/web, na którą prowadzi klik (deep-link do wizyty). Trzymana obok treści
  // z tego samego powodu i tym samym precedensem co CTA w szablonach maili, które też znają
  // trasy frontu; cena: zmiana routingu nie przepisze linków w starych wierszach.
  url       String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  // bookingId nullable, bo enum powiadomień może kiedyś objąć zdarzenia bez wizyty (np. konto);
  // Cascade jak w Review i Payment — seed kasuje i odtwarza rezerwacje firm demo, a RESTRICT
  // wywaliłby drugie `prisma db seed` na kluczu obcym.
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt]) // lista powiadomień użytkownika, najnowsze pierwsze
  @@index([userId, readAt]) // licznik nieprzeczytanych — endpoint odpytywany pollingiem
}
