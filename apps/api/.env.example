DATABASE_URL=postgresql://bookit:bookit@localhost:5432/bookit
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@bookit.local
APP_URL=http://localhost:4200
# Płatności (#50) — opcjonalne. Bez kluczy backend startuje normalnie, a usługi bez zaliczki
# działają jak dotąd; próba pobrania zaliczki kończy się wtedy błędem 503.
# Klucze z sandboxa Stripe: Developers → API keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Sekret podpisu webhooka (#51). Lokalnie NIE bierz go z dashboardu — Stripe nie dostarcza
# zdarzeń na localhost. Sekret wypisuje `stripe listen` (Stripe CLI) i jest ważny tylko przez
# czas tej sesji, więc po każdym restarcie CLI trzeba go tu wkleić na nowo. Szczegóły w README.
STRIPE_WEBHOOK_SECRET=
